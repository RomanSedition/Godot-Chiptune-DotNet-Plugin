# Godot 4+ specific ignores
.godot/
/android/

# .NET/C# build output (the mono build's own output already lands under
# .godot/mono/, ignored above; these are here in case a direct dotnet/msbuild
# invocation outside that ever writes to the project-root default instead)
bin/
obj/

# Rendered test output (M4WavRenderTest etc.) -- regenerated by running the
# test, not source; the .wav.import sidecar is still tracked.
tests/*.wav

.DS_Store
